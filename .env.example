## NOTE: Use .env.local for local development in cases of offline development or onboarding.

## Otherwise, Doppler will handle all values/secrets for cloud development and production

PROJECT_NAME=

APP_ENV=
NEXT_PUBLIC_APP_ENV=
PORT=

## Database (Postgres/Drizzle/Supabase)
## Composed from Supabase project settings — managed via Doppler

## DATABASE_URL: postgresql://{{SUPABASE_USER}}:{{SUPABASE_PASSWORD}}@aws-0-us-west-2.pooler.supabase.com:{{SUPABASE_DATABASE_PORT}}/{{SUPABASE_DB}}
DATABASE_URL=
## DIRECT_URL: postgresql://{{SUPABASE_USER}}:{{SUPABASE_PASSWORD}}@aws-0-us-west-2.pooler.supabase.com:{{SUPABASE_DIRECT_PORT}}/{{SUPABASE_DB}} 
DIRECT_URL=

## Supabase client
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_DEFAULT_KEY=
SUPABASE_SECRET_DEFAULT_KEY=

## OAuth - Clerk
OWNER_EMAILS=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SECRET=
AUTH_REDIRECT_PROXY_URL=

## Cache & Rate limiting - Upstash/Redis 
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

## Error logging/monitoring - Sentry
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=

## Messaging - Resend
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_TO_EMAIL=

## App URL - Subdomain via tunnel in development / Domain in production
NEXT_PUBLIC_APP_URL=
