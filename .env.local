## Bare minimum local development (Docker only, no cloud services)  
## For offline development or onboarding
## Docker (located in platform/dev-tools/docker) will spin up an instance of Postres and Redis

APP_ENV=local
NEXT_PUBLIC_APP_ENV=local
PORT=4000

NEXT_PUBLIC_APP_URL=http://localhost:4000

# Local Docker Postgres
DATABASE_URL=postgresql://postgres:password@localhost:5433/postgres
DIRECT_URL=postgresql://postgres:password@localhost:5433/postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_DB=postgres

# Local Docker Redis
UPSTASH_REDIS_REST_URL=http://localhost:8079
UPSTASH_REDIS_REST_TOKEN=local_token
