---
import { fetchWithFallback } from "../lib/fetch-with-fallback";

// Fetch bio from career-data API with graceful fallback for local dev
// when CAREER_DATA_URL is not set.

interface Bio {
  short: string;
  long: string;
}

const FALLBACK_BIO: Bio = {
  short: "Full-Stack Software Developer",
  long: `I'm a software developer who arrived here through a path most resumes don't follow. Before TypeScript, I was diagnosing vehicles, managing operations teams, building computers from components, and figuring out what was actually wrong when something stopped working. That systems-thinking instinct didn't go away when I moved into software — it just found a larger surface area.

Professionally, I spent four years at MarketVision Research building and maintaining custom survey applications, shipping ECharts dashboards for non-technical stakeholders, and co-developing a VS Code extension that automated workflows across the team. Independently, I designed and built dw-portfolio-platform — the system connected to this page. It's a production-grade monorepo with a Next.js platform dashboard, tRPC API, AI agents backed by Anthropic's Claude, eight parallel CI/CD jobs, and all cloud infrastructure managed through Terraform. I built it to show, not tell.`,
};

// /profile returns { contact, bio } — extract just bio, unlike Skills/
// Experience/Project which fetch endpoints that return an array directly.
const bio = await fetchWithFallback(FALLBACK_BIO, {
  baseUrl: import.meta.env.CAREER_DATA_URL,
  path: "/profile",
  parse: (json) => (json as { bio?: Bio }).bio,
});
// Split long bio on double newline for paragraph rendering
const paragraphs = bio.long.split("\n\n").filter(Boolean);
---

<section id="about">
  <div class="container">
    <p class="section-label" data-reveal>About</p>
    <h2 class="section-title" data-reveal data-reveal-delay="1">Who I am</h2>
    <div class="section-divider" data-reveal data-reveal-delay="1"></div>

    <div class="about-body" data-reveal data-reveal-delay="2">
      {paragraphs.map((p) => (
        <p set:html={p.replace(
          "dw-portfolio-platform",
          '<strong>dw-portfolio-platform</strong>'
        )} />
      ))}
    </div>
  </div>
</section>

<style>
  .about-body {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    max-width: 680px;
  }

  .about-body p {
    color: var(--text-muted);
    line-height: 1.85;
    font-size: 1.02rem;
  }

  .about-body strong {
    color: var(--accent);
    font-weight: 600;
  }
</style>