    "with-env": "dotenv -e ../../.env.local --"
  },
  "dependencies": {
    "@dw/db": "workspace:*",
    "@dw/redis": "workspace:*",
    "drizzle-orm": "catalog:",
    "uuid": "^13.0.0"
},
"devDependencies": {
    "@dw/eslint-config": "workspace:*",
    "@dw/prettier-config": "workspace:*",
    "@dw/tsconfig": "workspace:*",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "prettier": "catalog:",
    "tsx": "^4.21.0",
    "typescript": "catalog:"
  },
  "prettier": "@dw/prettier-config"
}
