{
  "name": "@dw/ops-scripts",
  "private": true,
  "type": "module",
  "license": "MIT",
    "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "tsc",
    "clean": "git clean -xdf .cache .turbo dist node_modules",
    "dev": "tsc",
    "format": "prettier --check . --ignore-path ../../.gitignore",
    "lint": "eslint",
    "seed": "pnpm with-env tsx typescript/seed.ts",
