{
  "name": "create-t3-turbo",
  "private": true,
  "engines": {
    "node": "^22.21.0",
    "pnpm": "^10.19.0"
  },
  "packageManager": "pnpm@10.28.2+sha512.41872f037ad22f7348e3b1debbaf7e867cfd448f2726d9cf74c08f19507c31d2c8e7a11525b983febc2df640b5438dee6023ebb1f84ed43cc2d654d2bc326264",
  "scripts": {
    "build": "turbo run build",
    "infra:up": "docker compose --env-file .env.local -f platform/dev-tools/docker/docker-compose.yml up -d",
    "infra:down": "docker compose --env-file .env.local -f platform/dev-tools/docker/docker-compose.yml down",
    "infra:logs": "docker compose -f platform/dev-tools/docker/docker-compose.yml logs -f",
    "infra:restart": "pnpm infra:down && pnpm infra:up",
    "clean:preview:artifacts": "pnpm -r exec ls -d dist .next .turbo .cache 2> /dev/null",
    "clean:preview:deps": "pnpm -r exec ls -d node_modules 2> /dev/null",
    "clean:artifacts": "pnpm -r exec rm -rf dist .next .turbo .cache",
    "clean:deps": "pnpm -r exec rm -rf node_modules && rm -rf node_modules",
    "clean:lock": "rm -f pnpm-lock.yaml",
    "clean:store": "pnpm store prune",
    "clean:workspaces": "turbo run clean",
    "clean:all": "pnpm clean:artifacts && pnpm clean:deps && pnpm clean:store",
    "db:generate": "turbo run db:generate",
    "db:push": "turbo run db:push",
    "db:studio": "turbo run db:studio",
    "dev:check": "bash platform/dev-tools/scripts/shell/wait-for-docker.sh && pnpm dev",
    "dev": "turbo watch dev --continue",
    "dev:next:check": "bash platform/dev-tools/scripts/shell/wait-for-docker.sh && pnpm dev:next",
    "dev:next": "turbo watch dev -F @dw/nextjs...",
    "dev:tunnel": "cloudflared tunnel --url http://localhost:3000",
    "format": "turbo run format --continue -- --cache --cache-location .cache/.prettiercache",
    "format:fix": "turbo run format --continue -- --write --cache --cache-location .cache/.prettiercache",
    "lint": "turbo run lint --continue -- --cache --cache-location .cache/.eslintcache",
    "lint:fix": "turbo run lint --continue -- --fix --cache --cache-location .cache/.eslintcache",
    "lint:ws": "pnpm dlx sherif@latest",
    "test:api:infra": "pnpm turbo run api:infrastructure:test",
    "test:setup": "turbo run dev-tools:test:setup",
    "dev:seed": "turbo run dev-tools:db:seed",
    "postinstall": "pnpm lint:ws",
    "typecheck": "turbo run typecheck",
    "ui-add": "turbo run ui-add",
    "android": "expo run:android",
    "ios": "expo run:ios"
  },
  "devDependencies": {
    "@dw/prettier-config": "workspace:*",
    "@turbo/gen": "^2.8.5",
    "dotenv-cli": "^10.0.0",
    "prettier": "catalog:",
    "turbo": "^2.8.5",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "prettier": "@dw/prettier-config"
}
