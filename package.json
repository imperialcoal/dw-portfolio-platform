{
  "name": "create-t3-turbo",
  "private": true,
  "engines": {
    "node": "^22.21.0",
    "pnpm": "^10.19.0"
  },
  "packageManager": "pnpm@10.19.0",
  "scripts": {
    "build": "turbo run build",
    "infra:up": "docker compose --env-file .env -f ops/docker/docker-compose.yml up -d",
    "infra:down": "docker compose --env-file .env -f ops/docker/docker-compose.yml down",
    "infra:logs": "docker compose -f ops/docker/docker-compose.yml logs -f",
    "infra:restart": "pnpm infra:down && pnpm infra:up",
    "clean:preview:artifacts": "pnpm -r exec ls -d dist .next .turbo .cache 2> /dev/null",
    "clean:preview:deps": "pnpm -r exec ls -d node_modules 2> /dev/null",
    "clean:artifacts": "pnpm -r exec rm -rf dist .next .turbo .cache",
    "clean:deps": "pnpm -r exec rm -rf node_modules && rm -rf node_modules",
    "clean:store": "pnpm store prune",
    "clean:workspaces": "turbo run clean",
    "clean:all": "pnpm clean:artifacts && pnpm clean:deps && pnpm clean:store",
    "auth:generate": "pnpm -F @dw/auth generate",
    "db:generate": "turbo -F @dw/db generate",
    "db:push": "turbo -F @dw/db push",
    "db:studio": "turbo -F @dw/db studio",
    "dev:check": "bash ops/scripts/shell/wait-for-docker.sh && pnpm dev",
    "dev": "turbo watch dev --continue",
    "dev:next:check": "bash ops/scripts/shell/wait-for-docker.sh && pnpm dev:next",
    "dev:next": "turbo watch dev -F @dw/nextjs...",
    "format": "turbo run format --continue -- --cache --cache-location .cache/.prettiercache",
    "format:fix": "turbo run format --continue -- --write --cache --cache-location .cache/.prettiercache",
    "lint": "turbo run lint --continue -- --cache --cache-location .cache/.eslintcache",
    "lint:fix": "turbo run lint --continue -- --fix --cache --cache-location .cache/.eslintcache",
    "lint:ws": "pnpm dlx sherif@latest",
    "ops:seed": "turbo -F @dw/ops-scripts seed", 
    "postinstall": "pnpm lint:ws",
    "typecheck": "turbo run typecheck",
    "ui-add": "turbo run ui-add",
    "android": "expo run:android",
    "ios": "expo run:ios"
  },
  "devDependencies": {
    "@dw/prettier-config": "workspace:*",
    "@turbo/gen": "^2.5.8",
    "dotenv-cli": "^10.0.0",
    "prettier": "catalog:",
    "turbo": "^2.5.8",
    "typescript": "catalog:"
  },
  "prettier": "@dw/prettier-config"
}
