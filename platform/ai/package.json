{
  "name": "@dw/ai",
  "private": true,
  "type": "module",
  "license": "MIT",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./src/index.ts"
    },
    "./actions": {
      "types": "./dist/actions/index.d.ts",
      "default": "./src/actions/index.ts"
    },
    "./agent": {
      "types": "./dist/agent/index.d.ts",
      "default": "./src/agent/index.ts"
    },
    "./analyzers": {
      "types": "./dist/analyzers/index.d.ts",
      "default": "./src/analyzers/index.ts"
    },
    "./memory": {
      "types": "./dist/memory/index.d.ts",
      "default": "./src/memory/index.ts"
    },
    "./sensors": {
      "types": "./dist/sensors/index.d.ts",
      "default": "./src/sensors/index.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "clean": "git clean -xdf .cache .turbo dist node_modules",
    "dev": "tsc",
    "format": "prettier --check . --ignore-path ../../.gitignore",
    "lint": "eslint",
    "typecheck": "tsc --noEmit --emitDeclarationOnly false"
  },
  "dependencies": {
    "@dw/config": "workspace:*",
    "@dw/contracts": "workspace:*",
    "@dw/db": "workspace:*",
    "@dw/llm": "workspace:*",
    "@dw/messaging": "workspace:*",
    "@dw/runtime": "workspace:*",
    "@dw/validators": "workspace:*"
  },
  "devDependencies": {
    "@dw/eslint-config": "workspace:*",
    "@dw/prettier-config": "workspace:*",
    "@dw/tsconfig": "workspace:*",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "prettier": "catalog:",
    "typescript": "catalog:"
  },
  "prettier": "@dw/prettier-config"
}
