{
  "name": "@dw/dev-tools-scripts",
  "private": true,
  "type": "module",
  "license": "MIT",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "tsc",
    "clean": "git clean -xdf .cache .turbo dist node_modules",
    "dev": "tsc",
    "format": "prettier --check . --ignore-path ../../../.gitignore",
    "lint": "eslint",
    "dev-tools:test:setup": "tsx ./typescript/setup-test-db.ts",
    "dev-tools:db:seed": "tsx ./typescript/seed.ts",
    "typecheck": "tsc --noEmit --emitDeclarationOnly false",
    "with-env": "dotenv -e ../../../../.env.local --"
  },
  "dependencies": {
    "@dw/config": "workspace:*",
    "@dw/db": "workspace:*",
    "@dw/env": "workspace:*",
    "@dw/redis": "workspace:*",
    "@dw/runtime": "workspace:*",
    "drizzle-orm": "catalog:",
    "postgres": "^3.4.8",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "@dw/eslint-config": "workspace:*",
    "@dw/prettier-config": "workspace:*",
    "@dw/tsconfig": "workspace:*",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "prettier": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:"
  },
  "prettier": "@dw/prettier-config"
}
