{
  "name": "@dw/runtime",
  "private": true,
  "type": "module",
  "license": "MIT",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./src/index.ts"
    },
    "./bootstrap": {
      "types": "./dist/bootstrap.d.ts",
      "default": "./src/bootstrap.ts"
    },
    "./boot-guard": {
      "types": "./dist/boot-guard.d.ts",
      "default": "./src/boot-guard.ts"
    },
    "./context": {
      "types": "./dist/context.d.ts",
      "default": "./src/context.ts"
    },
    "./deployment-environment": {
      "types": "./dist/deployment-environment.d.ts",
      "default": "./src/deployment-environment.ts"
    },
    "./init": {
      "types": "./dist/init.d.ts",
      "default": "./src/init.ts"
    },
    "./platform-identity": {
      "types": "./dist/platform-identity.d.ts",
      "default": "./src/platform-identity.ts"
    },
    "./process": {
      "types": "./dist/process.d.ts",
      "default": "./src/process.ts"
    },
    "./runtime-entry": {
      "types": "./dist/runtime-entry.d.ts",
      "default": "./src/runtime-entry.ts"
    },
    "./secret-source": {
      "types": "./dist/secret-source.d.ts",
      "default": "./src/secret-source.ts"
    },
    "./singletons": {
      "types": "./dist/singletons.d.ts",
      "default": "./src/singletons.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "clean": "git clean -xdf .cache .turbo dist node_modules",
    "dev": "tsc",
    "format": "prettier --check . --ignore-path ../../../.gitignore",
    "lint": "eslint",
    "typecheck": "tsc --noEmit --emitDeclarationOnly false",
    "platform:runtime:test": "vitest run"
  },
  "dependencies": {
    "@dw/db": "workspace:*",
    "@dw/env": "workspace:*",
    "@dw/health": "workspace:*",
    "@dw/redis": "workspace:*"
  },
  "devDependencies": {
    "@dw/eslint-config": "workspace:*",
    "@dw/prettier-config": "workspace:*",
    "@dw/tsconfig": "workspace:*",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "prettier": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "prettier": "@dw/prettier-config"
}
