{
  "name": "@dw/runtime",
  "private": true,
  "type": "module",
  "license": "MIT",
  "exports": {
    ".": "./src/index.ts",
    "./bootstrap": "./src/bootstrap.ts",
    "./boot-guard": "./src/boot-guard.ts",
    "./context": "./src/context.ts",
    "./deployment-environments": "./src/deployment-environments.ts",
    "./init": "./src/init.ts",
    "./platform-identity": "./src/platform-identity.ts",
    "./process": "./src/process.ts",
    "./runtime-entry": "./src/runtime-entry.ts",
    "./secret-source": "./src/secret-source.ts",
    "./singletons": "./src/singletons.ts"
  },
  "scripts": {
    "build": "tsc",
    "clean": "git clean -xdf .cache .turbo dist node_modules",
    "dev": "tsc",
    "format": "prettier --check . --ignore-path ../../../.gitignore",
    "lint": "eslint",
    "typecheck": "tsc --noEmit --emitDeclarationOnly false",
    "platform:runtime:test": "vitest run"
  },
  "dependencies": {
    "@dw/db": "workspace:*",
    "@dw/env": "workspace:*",
    "@dw/health": "workspace:*",
    "@dw/redis": "workspace:*"
  },
  "devDependencies": {
    "@dw/eslint-config": "workspace:*",
    "@dw/prettier-config": "workspace:*",
    "@dw/tsconfig": "workspace:*",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "prettier": "catalog:",
    "tsx": "^4.21.0",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "prettier": "@dw/prettier-config"
}
