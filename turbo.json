{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".cache/tsbuildinfo.json", "dist/**"]
    },
    "build:local": {
      "dependsOn": ["^build"],
      "outputs": [".cache/tsbuildinfo.json", "dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "dev:local": {
      "cache": false,
      "persistent": true
    },
    "format": {
      "outputs": [".cache/.prettiercache"],
      "outputLogs": "new-only"
    },
    "lint": {
      "dependsOn": ["^build"],
      "outputs": [".cache/.eslintcache"]
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": [".cache/tsbuildinfo.json"]
    },
    "clean": {
      "cache": false
    },
    "//#clean": {
      "cache": false
    },
    "db:generate": {
      "cache": false,
      "inputs": ["src/schema.ts", "drizzle.config.ts", "env.ts"]
    },
    "db:migrate": {
      "cache": false,
      "interactive": true
    },
    "db:migrate:local": {
      "cache": false,
      "interactive": true
    },
    "db:push": {
      "cache": false,
      "interactive": true
    },
    "db:push:local": {
      "cache": false,
      "interactive": true
    },
    "db:studio": {
      "cache": false,
      "persistent": true
    },
    "db:studio:local": {
      "cache": false,
      "persistent": true
    },
    "ui-add": {
      "cache": false,
      "interactive": true
    },
    "dev-tools:db:test-setup": {
      "cache": false,
      "inputs": [
        "$TURBO_DEFAULT$",
        "packages/db/src/schema.ts",
        "packages/db/src/auth-schema.ts"
      ]
    },
    "dev-tools:db:seed": {
      "cache": false
    },
    "dev-tools:infra:up": {
      "cache": false
    },
    "dev-tools:infra:down": {
      "cache": false
    },
    "dev-tools:infra:restart": {
      "cache": false
    },
    "dev-tools:infra:logs": {
      "cache": false,
      "persistent": true
    },
    "platform:runtime:test": {
      "outputs": ["coverage/**"], // add coverage flag to vitest later
      "cache": true
    },
    "api:infrastructure:test": {
      "dependsOn": ["@dw/dev-tools#dev-tools:db:test-setup"],
      "outputs": ["coverage/**"], // add coverage flag to vitest later
      "cache": false
    },
    "clerk:webhook:test": {
      "dependsOn": ["@dw/dev-tools#dev-tools:db:test-setup"],
      "outputs": ["coverage/**"], // add coverage flag to vitest later
      "cache": false
    }
  },
  "globalEnv": [
    "NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY",
    "NEXT_PUBLIC_SUPABASE_URL",
    "NEXT_PUBLIC_SUPABASE_PUBLISHABLE_DEFAULT_KEY",
    "NEXT_PUBLIC_APP_URL",
    "NEXT_PUBLIC_APP_ENV",
    "NEXT_PUBLIC_SENTRY_DSN"
  ],
  "globalPassThroughEnv": [
    "npm_lifecycle_event",
    "NODE_ENV",
    "APP_ENV",
    "NEXT_RUNTIME",
    "CI",
    "DOPPLER_CONFIG",
    "DOPPLER_ENVIRONMENT",
    "DOPPLER_PROJECT",
    "VERCEL",
    "VERCEL_ENV",
    "VERCEL_URL",
    "OWNER_EMAILS",
    "AUTH_REDIRECT_PROXY_URL",
    "CLERK_SECRET_KEY",
    "CLERK_WEBHOOK_SECRET",
    "DATABASE_URL",
    "DIRECT_URL",
    "POSTGRES_USER",
    "POSTGRES_PASSWORD",
    "POSTGRES_DB",
    "SUPABASE_DATABASE_PORT",
    "SUPABASE_DB",
    "SUPABASE_DIRECT_PORT",
    "SUPABASE_PASSWORD",
    "SUPABASE_PROJECT_REF",
    "SUPABASE_USER",
    "PORT",
    "PROJECT_NAME",
    "UPSTASH_REDIS_REST_URL",
    "UPSTASH_REDIS_REST_TOKEN",
    "SUPABASE_SECRET_DEFAULT_KEY",
    "SENTRY_AUTH_TOKEN",
    "RESEND_API_KEY",
    "RESEND_FROM_EMAIL",
    "RESEND_TO_EMAIL"
  ]
}
