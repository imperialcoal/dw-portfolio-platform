{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [
        ".next/**",
        "!.next/cache/**",
        ".cache/tsbuildinfo.json",
        "dist/**"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "format": {
      "outputs": [".cache/.prettiercache"],
      "outputLogs": "new-only"
    },
    "lint": {
      "dependsOn": ["^build"],
      "outputs": [".cache/.eslintcache"]
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": [".cache/tsbuildinfo.json"]
    },
    "clean": {
      "cache": false
    },
    "//#clean": {
      "cache": false
    },
    "db:generate": {
      "cache": false,
      "inputs": ["src/schema.ts", "drizzle.config.ts", "env.ts"]
    },
    "db:push": {
      "cache": false,
      "interactive": true
    },
    "db:studio": {
      "cache": false,
      "persistent": true
    },
    "ui-add": {
      "cache": false,
      "interactive": true
    },
    "dev-tools:db:test-setup": {
      "cache": false,
      "inputs": [
        "$TURBO_DEFAULT$",
        "packages/db/src/schema.ts",
        "packages/db/src/auth-schema.ts"
      ]
    },
    "dev-tools:db:seed": {
      "cache": false
    },
    "dev-tools:infra:up": {
      "cache": false
    },
    "dev-tools:infra:down": {
      "cache": false
    },
    "dev-tools:infra:restart": {
      "cache": false
    },
    "dev-tools:infra:logs": {
      "cache": false,
      "persistent": true
    },
    "platform:runtime:test": {
      "outputs": ["coverage/**"], // add coverage flag to vitest later
      "cache": true
    },
    "api:infrastructure:test": {
      "dependsOn": ["@dw/dev-tools#dev-tools:db:test-setup"],
      "outputs": ["coverage/**"], // add coverage flag to vitest later
      "cache": false
    },
    "clerk:webhook:test": {
      "outputs": ["coverage/**"], // add coverage flag to vitest later
      "cache": false
    }
  },
  "globalEnv": [
    "OWNER_EMAILS",
    "AUTH_REDIRECT_PROXY_URL",
    "NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY",
    "CLERK_SECRET_KEY",
    "CLERK_WEBHOOK_SECRET",
    "DATABASE_URL",
    "DIRECT_URL",
    "PORT",
    "PROJECT_NAME",
    "UPSTASH_REDIS_REST_URL",
    "UPSTASH_REDIS_REST_TOKEN"
  ],
  "globalPassThroughEnv": [
    "NODE_ENV",
    "APP_ENV",
    "NEXT_PUBLIC_APP_URL",
    "NEXT_PUBLIC_APP_ENV",
    "CI",
    "VERCEL",
    "VERCEL_ENV",
    "VERCEL_URL",
    "npm_lifecycle_event"
  ]
}
